{
  "manifest_version": 3,
  "name": "LinkedIn Farming & Scam Blocker",
  "version": "0.2.0",
  "description": "Collapses engagement-farming posts and scam job listings on LinkedIn, with the reason shown so you can tune the rules.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["cards.js", "counters.js", "rules.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
